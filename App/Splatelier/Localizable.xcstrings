    },
    "Display, then Orient, then turn the model until it stands upright" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「表示」→「向き」の順に選び、モデルがまっすぐ立つまで回します"
          }
