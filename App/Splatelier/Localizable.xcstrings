          }
        }
      }
    },
    "The wide-angle loop closure's models include DINOv3, used under the DINOv3 License. Extracting, decompiling or reverse-engineering the bundled models is not permitted." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
